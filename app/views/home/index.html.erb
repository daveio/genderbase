<% content_for :title, "Genderbase · Questions about gender, answered in good faith" %>

<section class="glow-hero">
  <div class="container mx-auto px-4 sm:px-6 md:px-8 py-20 md:py-28 max-w-6xl">
    <p class="type-eyebrow rise">A knowledge base and Q&amp;A about gender</p>
    <h1 class="type-display text-5xl md:text-7xl mt-4 max-w-4xl rise rise-2">
      Questions about gender, <span class="ink-gradient">answered in good faith.</span>
    </h1>
    <p class="mt-6 text-lg md:text-xl text-base-content/75 max-w-2xl rise rise-3">
      Ask anonymously if you like. Volunteer responders reply within a few days, and nobody expects you to get the words right first time.
    </p>
    <div class="mt-10 flex flex-wrap gap-3 rise rise-4">
      <%= link_to "Ask a Question", new_question_path, class: "btn btn-primary btn-lg" %>
      <%= link_to "Browse the Knowledge Base", knowledges_path, class: "btn btn-outline btn-lg" %>
    </div>
  </div>
</section>

<section class="container mx-auto px-4 sm:px-6 md:px-8 py-14 max-w-6xl">
  <div class="grid gap-6 md:grid-cols-3">
    <article class="edge-card p-8 flex flex-col">
      <p class="type-eyebrow text-primary">Ask</p>
      <h2 class="type-display text-2xl mt-3">Get an answer from a real person</h2>
      <p class="mt-3 text-base-content/75 grow">Vetted volunteer responders read every question and reply in good faith, whatever you ask.</p>
      <%= link_to "Ask a Question", new_question_path, class: "btn btn-primary btn-sm self-start mt-6" %>
    </article>

    <article class="edge-card p-8 flex flex-col">
      <p class="type-eyebrow text-secondary">Knowledge Base</p>
      <h2 class="type-display text-2xl mt-3">Read what others have asked</h2>
      <p class="mt-3 text-base-content/75 grow">Curated articles built from real questions and the answers they received.</p>
      <%= link_to "Browse the Knowledge Base", knowledges_path, class: "btn btn-secondary btn-sm self-start mt-6" %>
    </article>

    <article class="edge-card p-8 flex flex-col">
      <p class="type-eyebrow text-accent">Language</p>
      <h2 class="type-display text-2xl mt-3">Find the right words</h2>
      <p class="mt-3 text-base-content/75 grow">A glossary of gender terminology, with examples of how each term is used.</p>
      <%= link_to "How Do I Say...?", terminologies_path, class: "btn btn-accent btn-sm self-start mt-6" %>
    </article>
  </div>
</section>

<section class="container mx-auto px-4 sm:px-6 md:px-8 pb-20 max-w-6xl">
  <div class="edge-card p-8 md:p-10 md:flex md:items-center md:justify-between gap-8">
    <div>
      <p class="type-eyebrow">Get involved</p>
      <h2 class="type-display text-2xl md:text-3xl mt-3">Genderbase runs on donations and volunteers</h2>
      <p class="mt-3 text-base-content/75 max-w-xl">Keep it free and keep it kind: chip in, or lend a few hours a week.</p>
    </div>
    <div class="flex flex-wrap gap-3 mt-6 md:mt-0 shrink-0">
      <%= link_to "Make a Donation", home_donate_path, class: "btn btn-secondary" %>
      <%= link_to "Volunteer", home_volunteer_path, class: "btn btn-ghost" %>
    </div>
  </div>
</section>
