<% content_for :title, "Forgot your password? · Genderbase" %>

<section class="auth-page">
  <div class="container mx-auto px-4 sm:px-6 md:px-8 py-16 md:py-24 max-w-md">
    <p class="type-eyebrow text-secondary">Responders</p>
    <h1 class="type-display text-4xl mt-3">Forgot your password?</h1>
    <p class="mt-3 text-base-content/70">Enter the email on your responder account and we'll send a link to choose a new one.</p>

    <div class="edge-card p-6 md:p-8 mt-8">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |form| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <fieldset class="fieldset">
          <%= form.label :email, "Email", class: "label font-medium text-base-content" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input w-full" %>
        </fieldset>

        <%= form.submit "Email me a reset link", class: "btn btn-primary w-full" %>
      <% end %>
    </div>

    <%= render "devise/shared/links" %>
  </div>
</section>
