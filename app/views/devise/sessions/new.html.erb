<% content_for :title, "Log in · Genderbase" %>

<section class="auth-page">
  <div class="container mx-auto px-4 sm:px-6 md:px-8 py-16 md:py-24 max-w-md">
    <p class="type-eyebrow text-secondary">Responders</p>
    <h1 class="type-display text-4xl mt-3">Log in</h1>
    <p class="mt-3 text-base-content/70">Responder accounts are for vetted volunteers who answer questions.</p>

    <div class="edge-card p-6 md:p-8 mt-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |form| %>
        <fieldset class="fieldset">
          <%= form.label :email, "Email", class: "label font-medium text-base-content" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input w-full" %>
        </fieldset>

        <fieldset class="fieldset">
          <%= form.label :password, "Password", class: "label font-medium text-base-content" %>
          <%= form.password_field :password, autocomplete: "current-password", required: true, class: "input w-full" %>
        </fieldset>

        <% if devise_mapping.rememberable? %>
          <label class="label cursor-pointer gap-3 text-base-content">
            <%= form.check_box :remember_me, class: "checkbox checkbox-sm" %>
            <span>Remember me on this device</span>
          </label>
        <% end %>

        <%= form.submit "Log in", class: "btn btn-primary w-full" %>
      <% end %>
    </div>

    <%= render "devise/shared/links" %>
  </div>
</section>
