<% content_for :title, "Account settings · Genderbase" %>

<section class="auth-page">
  <div class="container mx-auto px-4 sm:px-6 md:px-8 py-16 md:py-24 max-w-md">
    <p class="type-eyebrow text-secondary">Responders</p>
    <h1 class="type-display text-4xl mt-3">Account settings</h1>
    <p class="mt-3 text-base-content/70">Update your email or password. Your current password confirms any change.</p>

    <div class="edge-card p-6 md:p-8 mt-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |form| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <fieldset class="fieldset">
          <%= form.label :email, "Email", class: "label font-medium text-base-content" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input w-full" %>
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="label">Waiting for confirmation of <%= resource.unconfirmed_email %></p>
          <% end %>
        </fieldset>

        <fieldset class="fieldset">
          <%= form.label :password, "New password", class: "label font-medium text-base-content" %>
          <%= form.password_field :password, autocomplete: "new-password", class: "input w-full" %>
          <p class="label">
            Leave blank to keep your current password.
            <% if @minimum_password_length %>
              <%= @minimum_password_length %> characters minimum.
            <% end %>
          </p>
        </fieldset>

        <fieldset class="fieldset">
          <%= form.label :password_confirmation, "Confirm new password", class: "label font-medium text-base-content" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "input w-full" %>
        </fieldset>

        <fieldset class="fieldset">
          <%= form.label :current_password, "Current password", class: "label font-medium text-base-content" %>
          <%= form.password_field :current_password, autocomplete: "current-password", required: true, class: "input w-full" %>
        </fieldset>

        <%= form.submit "Save changes", class: "btn btn-primary w-full" %>
      <% end %>
    </div>

    <div class="edge-card p-6 md:p-8 mt-6">
      <h2 class="type-display text-2xl">Delete account</h2>
      <p class="mt-2 text-sm text-base-content/70">This removes your responder account. Your answers, knowledge base entries and terminology are deleted with it.</p>
      <%= button_to "Delete my account", registration_path(resource_name),
                    method: :delete,
                    class: "btn btn-outline btn-error mt-4",
                    data: { turbo_confirm: "Delete your account and everything you've written? This cannot be undone." } %>
    </div>
  </div>
</section>
