<% content_for :title, "Sign up · Genderbase" %>

<section class="auth-page">
  <div class="container mx-auto px-4 sm:px-6 md:px-8 py-16 md:py-24 max-w-md">
    <p class="type-eyebrow text-secondary">Responders</p>
    <h1 class="type-display text-4xl mt-3">Sign up</h1>
    <p class="mt-3 text-base-content/70">Create a responder account. Use a long, unusual passphrase; short or common passwords are rejected.</p>

    <div class="edge-card p-6 md:p-8 mt-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |form| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <fieldset class="fieldset">
          <%= form.label :email, "Email", class: "label font-medium text-base-content" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input w-full" %>
        </fieldset>

        <fieldset class="fieldset">
          <%= form.label :password, "Password", class: "label font-medium text-base-content" %>
          <%= form.password_field :password, autocomplete: "new-password", required: true, class: "input w-full" %>
          <% if @minimum_password_length %>
            <p class="label"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </fieldset>

        <fieldset class="fieldset">
          <%= form.label :password_confirmation, "Confirm password", class: "label font-medium text-base-content" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "input w-full" %>
        </fieldset>

        <%= form.submit "Sign up", class: "btn btn-primary w-full" %>
      <% end %>
    </div>

    <%= render "devise/shared/links" %>
  </div>
</section>
